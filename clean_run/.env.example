GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
WEATHER_API_KEY=
FLIGHT_API_TOKEN=

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DATABASE=tourunipp2
MONGODB_COLLECTION=trip_sessions

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=touruni-api
JWT_AUDIENCE=touruni-pwa
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=touruni_refresh_token
COOKIE_SECURE=false

CORS_ALLOW_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
FLIGHT_USD_TO_LKR_RATE=300

# Protects the internal endpoints called by the GitHub Actions scheduler.
CRON_SECRET=replace-with-a-long-random-secret
SCHEDULER_TIMEZONE=Asia/Colombo
SCHEDULER_LOOKAHEAD_DAYS=7
MOOD_REMINDER_START_HOUR=8
MOOD_REMINDER_END_HOUR=20

# Firebase Admin — needed only for the optional IoT feature, to mint custom
# tokens for the mobile app and ESP32 devices. Set ONE of these two.
# Local dev: absolute path to the service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Hosted (Render/Railway/Docker secrets): the whole JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON=
# RTDB URL. Required for live telemetry — /iot/telemetry writes the device's
# safety data here for the mobile app to listen to. Minting custom tokens works
# without it, which is why it was missing while tokens were the only feature.
FIREBASE_DATABASE_URL=https://smartdriversafety-33479-default-rtdb.firebaseio.com
